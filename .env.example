# ============================================
# Island Rave - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# --------------------------------------------
# 1. Supabase PostgreSQL Database
# --------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# 
# DATABASE_URL: Transaction connection pooler (port 6543) - used by app queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection (port 5432) - used by Prisma migrations & db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --------------------------------------------
# 2. Application URL & Environment
# --------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --------------------------------------------
# 3. Authentication & Security
# --------------------------------------------
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRES_IN=7d

# --------------------------------------------
# 4. Payment Gateway - Paystack
# --------------------------------------------
# Found in: Paystack Dashboard -> Settings -> API Keys & Webhooks
# For Live: pk_live_... / sk_live_...
# For Test: pk_test_... / sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Payment Mode: 'demo' for local simulator, 'live' for real Paystack checkout
PAYMENT_MODE=demo

# --------------------------------------------
# 5. Email Notification Configuration
# --------------------------------------------
EMAIL_FROM="Island Rave <noreply@islandrave.com>"
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --------------------------------------------
# 6. Staff & Admin Seed Credentials
# --------------------------------------------
ADMIN_EMAIL=admin@islandrave.com
ADMIN_PASSWORD=SuperAdmin2026!

STAFF_EMAIL=gate@islandrave.com
STAFF_PASSWORD=GateScanner2026!

MANAGER_EMAIL=manager@islandrave.com
MANAGER_PASSWORD=RaveManager2026!

FINANCE_EMAIL=finance@islandrave.com
FINANCE_PASSWORD=RaveFinance2026!
